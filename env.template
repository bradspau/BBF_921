# TMF921 Intent Management API — Environment Variables
# Copy this to .env and adjust for your environment.
# These are the only variables the application reads at runtime.

# Apache Jena Fuseki — SPARQL endpoint base URL (no trailing slash)
FUSEKI_BASE_URL=http://localhost:3030

# Fuseki dataset name (auto-created on first startup if absent)
FUSEKI_DATASET=tmf921

# uvicorn log level: debug | info | warning | error | critical
LOG_LEVEL=info
