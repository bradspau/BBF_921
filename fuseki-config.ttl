@prefix fuseki:  <http://jena.apache.org/fuseki#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix tdb2:    <http://jena.apache.org/2016/tdb2#> .
@prefix ja:      <http://jena.hpl.hp.com/2005/11/Assembler#> .

# ── Main API dataset: TDB2, no inference ─────────────────────────────────────
# All API resources live in per-resource named graphs here.

<#mainService> rdf:type fuseki:Service ;
    fuseki:name "tmf921" ;
    fuseki:endpoint [ fuseki:operation fuseki:query  ; fuseki:name "sparql" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ; fuseki:name "update" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ; fuseki:name "data"   ] ;
    fuseki:dataset <#mainDataset> .

<#mainDataset> rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/tmf921" .

# ── Eval dataset: in-memory default model with TIO rule inference ─────────────
# The evaluator writes an expression's Turtle to the default graph, queries
# for derived intentHandlingState, then clears. One evaluation at a time
# (semaphore in evaluator.py).

<#evalService> rdf:type fuseki:Service ;
    fuseki:name "tmf921-eval" ;
    fuseki:endpoint [ fuseki:operation fuseki:query  ; fuseki:name "sparql" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ; fuseki:name "update" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ; fuseki:name "data"   ] ;
    fuseki:dataset <#evalDataset> .

<#evalDataset> rdf:type ja:RDFDataset ;
    ja:defaultModel <#evalInfModel> .

<#evalInfModel> rdf:type ja:InfModel ;
    ja:baseModel <#evalBaseModel> ;
    ja:reasoner  <#tioReasoner> .

<#evalBaseModel> rdf:type ja:MemoryModel .

<#tioReasoner> rdf:type ja:GenericRuleReasoner ;
    ja:rulesFrom <file:///opt/fuseki/rules/tio_all.rules> .
